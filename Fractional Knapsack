#include <stdio.h>

#define MAX 100

struct Package {
    int id;
    float value, weight, ratio, fraction;
};

struct Package p[MAX];
int n = 0;
float capacity = 0, maxValue = 0, totalWeight = 0;
int detailsEntered = 0, ratiosCalculated = 0, sorted = 0, calculated = 0;

void enterDetails() {
    printf("Enter number of packages: ");
    scanf("%d", &n);

    if (n < 1 || n > MAX) {
        printf("Invalid number of packages.\n");
        n = 0;
        detailsEntered = 0;
        return;
    }

    for (int i = 0; i < n; i++) {
        p[i].id = i + 1;

        printf("Enter value and weight of package %d: ", i + 1);
        scanf("%f %f", &p[i].value, &p[i].weight);

        if (p[i].value < 0 || p[i].weight <= 0) {
            printf("Invalid value or weight.\n");
            n = 0;
            detailsEntered = 0;
            return;
        }

        p[i].ratio = 0;
        p[i].fraction = 0;
    }

    printf("Enter knapsack capacity: ");
    scanf("%f", &capacity);

    if (capacity < 0) {
        printf("Invalid capacity.\n");
        n = 0;
        detailsEntered = 0;
        return;
    }

    detailsEntered = 1;
    ratiosCalculated = 0;
    sorted = 0;
    calculated = 0;

    printf("Package details entered successfully.\n");
}

void displayDetails() {
    if (!detailsEntered) {
        printf("Please enter package details first.\n");
        return;
    }

    printf("\nPackage\tValue\tWeight\n");

    for (int i = 0; i < n; i++) {
        printf("P%d\t%.2f\t%.2f\n", p[i].id, p[i].value, p[i].weight);
    }

    printf("Knapsack Capacity: %.2f\n", capacity);
}

void calculateRatio() {
    if (!detailsEntered) {
        printf("Please enter package details first.\n");
        return;
    }

    for (int i = 0; i < n; i++) {
        p[i].ratio = p[i].value / p[i].weight;
    }

    ratiosCalculated = 1;
    sorted = 0;
    calculated = 0;

    printf("\nPackage\tValue\tWeight\tRatio\n");

    for (int i = 0; i < n; i++) {
        printf("P%d\t%.2f\t%.2f\t%.2f\n",
               p[i].id, p[i].value, p[i].weight, p[i].ratio);
    }
}

void sortPackages() {
    if (!detailsEntered) {
        printf("Please enter package details first.\n");
        return;
    }

    if (!ratiosCalculated) {
        calculateRatio();
    }

    struct Package temp;

    for (int i = 0; i < n - 1; i++) {
        for (int j = 0; j < n - i - 1; j++) {
            if (p[j].ratio < p[j + 1].ratio) {
                temp = p[j];
                p[j] = p[j + 1];
                p[j + 1] = temp;
            }
        }
    }

    sorted = 1;
    calculated = 0;

    printf("\nPackages sorted by value-to-weight ratio:\n");
    printf("Package\tValue\tWeight\tRatio\n");

    for (int i = 0; i < n; i++) {
        printf("P%d\t%.2f\t%.2f\t%.2f\n",
               p[i].id, p[i].value, p[i].weight, p[i].ratio);
    }
}

void findMaximumValue() {
    if (!detailsEntered) {
        printf("Please enter package details first.\n");
        return;
    }

    if (!ratiosCalculated) {
        calculateRatio();
    }

    if (!sorted) {
        sortPackages();
    }

    float remaining = capacity;
    maxValue = 0;
    totalWeight = 0;

    for (int i = 0; i < n; i++) {
        p[i].fraction = 0;

        if (remaining <= 0) {
            break;
        }

        if (p[i].weight <= remaining) {
            p[i].fraction = 1;
            remaining -= p[i].weight;
            maxValue += p[i].value;
            totalWeight += p[i].weight;
        } else {
            p[i].fraction = remaining / p[i].weight;
            maxValue += p[i].value * p[i].fraction;
            totalWeight += remaining;
            remaining = 0;
        }
    }

    calculated = 1;

    printf("\nMaximum value: %.2f\n", maxValue);
    printf("Total weight used: %.2f\n", totalWeight);
}

void displaySelectedPackages() {
    if (!calculated) {
        printf("Please calculate the maximum value first.\n");
        return;
    }

    printf("\nPackage\tFraction\tWeight Taken\tValue Taken\n");

    for (int i = 0; i < n; i++) {
        if (p[i].fraction > 0) {
            printf("P%d\t%.2f\t\t%.2f\t\t%.2f\n",
                   p[i].id,
                   p[i].fraction,
                   p[i].weight * p[i].fraction,
                   p[i].value * p[i].fraction);
        }
    }

    printf("\nTotal Weight: %.2f\n", totalWeight);
    printf("Maximum Value: %.2f\n", maxValue);
}

int main() {
    int choice;

    do {
        printf("\n--- Fractional Knapsack Menu ---\n");
        printf("1. Enter Package Details\n");
        printf("2. Display Package Details\n");
        printf("3. Calculate Value-to-Weight Ratio\n");
        printf("4. Sort Packages by Ratio\n");
        printf("5. Find Maximum Value\n");
        printf("6. Display Selected Packages\n");
        printf("7. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);

        switch (choice) {
            case 1:
                enterDetails();
                break;
            case 2:
                displayDetails();
                break;
            case 3:
                calculateRatio();
                break;
            case 4:
                sortPackages();
                break;
            case 5:
                findMaximumValue();
                break;
            case 6:
                displaySelectedPackages();
                break;
            case 7:
                printf("Exiting program.\n");
                break;
            default:
                printf("Invalid choice. Try again.\n");
        }
    } while (choice != 7);

    return 0;
}
